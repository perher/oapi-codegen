// Handler creates http.Handler with routing matching OpenAPI spec.
func {{ opts.OutputOptions.TypePrefix }}Handler(si {{ opts.OutputOptions.TypePrefix }}ServerInterface) http.Handler {
  return {{ opts.OutputOptions.TypePrefix }}HandlerWithOptions(si, StdHTTPServerOptions{})
}

{{ if not opts.OutputOptions.TypePrefix }}
// ServeMux is an abstraction of http.ServeMux.
type ServeMux interface {
	HandleFunc(pattern string, handler func(http.ResponseWriter, *http.Request))
	ServeHTTP(w http.ResponseWriter, r *http.Request)
}

type StdHTTPServerOptions struct {
    BaseURL          string
    BaseRouter       ServeMux
    Middlewares      []MiddlewareFunc
    ErrorHandlerFunc func(w http.ResponseWriter, r *http.Request, err error)
}
{{- end }}{{/* if not opts.OutputOptions.TypePrefix */}}

// HandlerFromMux creates http.Handler with routing matching OpenAPI spec based on the provided mux.
func {{ opts.OutputOptions.TypePrefix }}HandlerFromMux(si {{ opts.OutputOptions.TypePrefix }}ServerInterface, m ServeMux) http.Handler {
    return {{ opts.OutputOptions.TypePrefix }}HandlerWithOptions(si, StdHTTPServerOptions {
        BaseRouter: m,
    })
}

func {{ opts.OutputOptions.TypePrefix }}HandlerFromMuxWithBaseURL(si {{ opts.OutputOptions.TypePrefix }}ServerInterface, m ServeMux, baseURL string) http.Handler {
    return {{ opts.OutputOptions.TypePrefix }}HandlerWithOptions(si, StdHTTPServerOptions {
        BaseURL: baseURL,
        BaseRouter: m,
    })
}

// HandlerWithOptions creates http.Handler with additional options
func {{ opts.OutputOptions.TypePrefix }}HandlerWithOptions(si {{ opts.OutputOptions.TypePrefix }}ServerInterface, options StdHTTPServerOptions) http.Handler {
	m := options.BaseRouter

	if m == nil {
		m = http.NewServeMux()
	}
	if options.ErrorHandlerFunc == nil {
		options.ErrorHandlerFunc = func(w http.ResponseWriter, r *http.Request, err error) {
			http.Error(w, err.Error(), http.StatusBadRequest)
		}
	}
{{if .}}
	wrapper := {{ opts.OutputOptions.TypePrefix }}ServerInterfaceWrapper{
		Handler: si,
		HandlerMiddlewares: options.Middlewares,
		ErrorHandlerFunc: options.ErrorHandlerFunc,
	}
{{end}}
{{range .}}m.HandleFunc("{{.Method }} "+options.BaseURL+"{{.Path | swaggerUriToStdHttpUri}}", wrapper.{{.OperationId}})
{{end}}
	return m
}
